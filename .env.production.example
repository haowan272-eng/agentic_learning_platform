# Copy to .env on the deployment host and replace every secret.

POSTGRES_USER=interview_user
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=interview_improvement_rag

REDIS_PASSWORD=change-me-redis-password

SECRET_KEY=change-me-to-a-long-random-secret-with-32-plus-chars
REFRESH_SECRET_KEY=change-me-to-another-long-random-secret-with-32-plus-chars
CORS_ORIGINS=https://your-client.example.com

DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=false
QDRANT_COLLECTION_NAME=interview_improvement_chunks
QDRANT_DIM=1024

AGENT_PLANNER_MODEL_CHAIN=deepseek,openai,anthropic
AGENT_ARCHITECT_MODEL_CHAIN=deepseek,openai,anthropic
AGENT_JUDGE_MODEL_CHAIN=deepseek,openai,anthropic
AGENT_PLANNER_CANDIDATE_COUNT=2
AGENT_TASK_DEFAULT_DEADLINE_SECONDS=900
AGENT_TASK_DEFAULT_MAX_STEPS=8
AGENT_TASK_DEFAULT_MAX_TOOL_CALLS=12
AGENT_TASK_DEFAULT_MAX_TOKENS=24000
AGENT_TASK_DEFAULT_MAX_COST_USD=2.0
AGENT_LLM_TIMEOUT_SECONDS=60
AGENT_LLM_PROVIDER_FAILURE_THRESHOLD=2
AGENT_LLM_PROVIDER_COOLDOWN_SECONDS=30

# Leave empty to disable sandbox execution.
AGENT_SANDBOX_URL=
AGENT_SANDBOX_TOKEN=
AGENT_SANDBOX_TIMEOUT_SECONDS=30

# Leave empty to disable local Qwen-VL/vLLM vision captioning.
VISION_MODEL=
VISION_BASE_URL=http://host.docker.internal:8001/v1
VISION_API_KEY=EMPTY

LANGGRAPH_CHECKPOINT_SETUP=false
MODEL_ROOT=/srv/interview-improvement-rag/models
BACKEND_PORT=8001
FRONTEND_PORT=80
