# Copy to .env for local development.

APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

POSTGRES_USER=interview_user
POSTGRES_PASSWORD=interview_password
POSTGRES_DB=interview_improvement_rag

DATABASE_URL=postgresql://interview_user:interview_password@127.0.0.1:15432/interview_improvement_rag
REDIS_URL=redis://localhost:16379/0
CELERY_BROKER_URL=redis://localhost:16379/1
CELERY_RESULT_BACKEND=redis://localhost:16379/2

SECRET_KEY=change-me-development-secret-key-32chars
REFRESH_SECRET_KEY=change-me-development-refresh-key-32chars
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8001,http://127.0.0.1:8001

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=false
QDRANT_COLLECTION_NAME=interview_improvement_chunks
QDRANT_DIM=1024

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

AGENT_PLANNER_MODEL_CHAIN=deepseek,openai,anthropic
AGENT_ARCHITECT_MODEL_CHAIN=deepseek,openai,anthropic
AGENT_JUDGE_MODEL_CHAIN=deepseek,openai,anthropic
AGENT_PLANNER_CANDIDATE_COUNT=2
AGENT_LLM_TIMEOUT_SECONDS=60
AGENT_LLM_PROVIDER_FAILURE_THRESHOLD=2
AGENT_LLM_PROVIDER_COOLDOWN_SECONDS=30

# Optional. Leave empty for public GitHub API access.
GITHUB_TOKEN=
GITHUB_RETRY_ATTEMPTS=3
GITHUB_CACHE_TTL_SECONDS=3600

# Leave empty to disable sandbox execution.
AGENT_SANDBOX_URL=
AGENT_SANDBOX_TOKEN=
AGENT_SANDBOX_TIMEOUT_SECONDS=30

# Leave empty to disable local Qwen-VL/vLLM vision captioning.
VISION_MODEL=
VISION_BASE_URL=http://host.docker.internal:8001/v1
VISION_API_KEY=EMPTY

LANGGRAPH_CHECKPOINT_SETUP=false
MODEL_ROOT=~/models
UPLOAD_DIR=uploads
FRONTEND_PORT=5173
BACKEND_PORT=8001
